{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1) 编译所有 .ui -> .py",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\tools\\build_ui.py"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "2) 打开 Qt Designer",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\pyside6-designer.exe",
      "problemMatcher": []
    },
    {
      "label": "3) 运行程序",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\main.py"
      ],
      "problemMatcher": []
    }
  ]
}
